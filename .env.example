# PROXIMA by Project Buddy — Environment Configuration Example

# System Mode Configuration (REAL vs DEMO)
PROXIMA_APP_MODE=REAL
PROXIMA_ZERO_FABRICATION_STRICT=true

# Proxima Cloud Gateway & Outbound Local Bridge Setup
NEXT_PUBLIC_PROXIMA_BRIDGE_URL=http://127.0.0.1:11435
CLOUD_GATEWAY_URL=http://localhost:3000/api/gateway
PROXIMA_BRIDGE_TOKEN=prx_bridge_token_default_2026

# Local Ollama AI Engine (Runs locally on PC only - NEVER exposed publicly)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b

# Titan Mail First-Class Integration Credentials (Stored securely on local PC)
TITAN_EMAIL_USER=shivam@projectbuddy.in
TITAN_EMAIL_PASS=your-secure-titan-password
TITAN_SMTP_HOST=smtp.titan.email
TITAN_SMTP_PORT=465
TITAN_IMAP_HOST=imap.titan.email
TITAN_IMAP_PORT=993
