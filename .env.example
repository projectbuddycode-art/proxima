# PROXIMA BY PROJECT BUDDY — ENVIRONMENT CONFIGURATION

# Production Persistent Database (PostgreSQL / Neon / Vercel Postgres / Cloud SQL)
# Leave empty for local development using db.json
DATABASE_URL=postgresql://user:password@ep-cool-db.us-east-1.aws.neon.tech/proxima?sslmode=require

# Cloud Gateway URL (Required for Local Bridge to connect)
CLOUD_GATEWAY_URL=https://your-proxima-domain.vercel.app/api/gateway

# Bridge Pairing Token (Issued upon pairing completion)
PROXIMA_BRIDGE_TOKEN=prx_bridge_token_example

# Local Ollama Base URL & Default Model
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:3b

# Allowed CORS Origin for Local Bridge
PROXIMA_ALLOWED_ORIGIN=http://localhost:3000

# Titan Mail Integration (SMTP / IMAP)
TITAN_SMTP_HOST=smtp.titan.email
TITAN_SMTP_PORT=465
TITAN_SMTP_USER=shivam@projectbuddy.in
TITAN_SMTP_PASS=your-titan-password
TITAN_IMAP_HOST=imap.titan.email
TITAN_IMAP_PORT=993
